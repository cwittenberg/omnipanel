#: prefs_hotkeys.js:30
msgid "Hotkeys"
msgstr "Teclas de acceso rápido"

#: prefs_hotkeys.js:35
msgid "Directional Snapping"
msgstr "Ajuste direccional"

#: prefs_hotkeys.js:36
msgid "Quickly snap the currently focused window into adjacent Drop Zones."
msgstr "Coloque rápidamente la ventana actualmente enfocada en las zonas de colocación adyacentes."

#: prefs_hotkeys.js:38
msgid "Snap Left"
msgstr "Ajustar a la izquierda"

#: prefs_hotkeys.js:38
msgid "Move window to the nearest zone on the left."
msgstr "Mueve la ventana a la zona más cercana a la izquierda."

#: prefs_hotkeys.js:38
msgid "Alt + Left"
msgstr "Alt + Izquierda"

#: prefs_hotkeys.js:39
msgid "Snap Right"
msgstr "Ajustar a la derecha"

#: prefs_hotkeys.js:39
msgid "Move window to the nearest zone on the right."
msgstr "Mueve la ventana a la zona más cercana a la derecha."

#: prefs_hotkeys.js:39
msgid "Alt + Right"
msgstr "Alt + Derecha"

#: prefs_hotkeys.js:40
msgid "Snap Up"
msgstr "Lanzarse sobre"

#: prefs_hotkeys.js:40
msgid "Move window to the nearest zone above."
msgstr "Mueva la ventana a la zona más cercana arriba."

#: prefs_hotkeys.js:40
msgid "Alt + Up"
msgstr "Alt + Arriba"

#: prefs_hotkeys.js:41
msgid "Snap Down"
msgstr "Ajustar hacia abajo"

#: prefs_hotkeys.js:41
msgid "Move window to the nearest zone below."
msgstr "Mueva la ventana a la zona más cercana a continuación."

#: prefs_hotkeys.js:41
msgid "Alt + Down"
msgstr "Alt + Abajo"

#: prefs_hotkeys.js:45
msgid "Drag & Drop Override"
msgstr "Anulación de arrastrar y soltar"

#: prefs_hotkeys.js:46
msgid "Bypass OmniPanel's layout engine for manual window placement."
msgstr "Omita el motor de diseño de OmniPanel para la colocación manual de ventanas."

#: prefs_hotkeys.js:49
msgid "Temporarily Disable Snapping"
msgstr "Desactivar temporalmente el ajuste"

#: prefs_hotkeys.js:50
msgid ""
"Hold this modifier while dragging a window to hide Drop Zones and allow free-"
"floating placement. Releasing the window drops its zone affinity."
msgstr "Mantenga presionado este modificador mientras arrastra una ventana para ocultar las zonas de colocación y permitir una ubicación flotante. Al soltar la ventana se pierde su afinidad de zona."

#: prefs_hotkeys.js:51
msgid "Hold Alt (or Alt Gr)"
msgstr "Mantenga presionada la tecla Alt (o Alt Gr)"

#: prefs_hotkeys.js:56
msgid "Layout Management"
msgstr "Gestión de diseño"

#: prefs_hotkeys.js:57
msgid "These shortcuts can be customized in the Layouts tab."
msgstr "Estos atajos se pueden personalizar en la pestaña Diseños."

#: prefs_hotkeys.js:60
msgid "Cycle Layouts"
msgstr "Diseños de ciclo"

#: prefs_hotkeys.js:61
msgid "Instantly switch between your saved layouts."
msgstr "Cambie instantáneamente entre sus diseños guardados."

#: prefs_hotkeys.js:62
msgid "Configurable (Default: Alt + -)"
msgstr "Configurable (predeterminado: Alt + -)"

#: prefs_hotkeys.js:65
msgid "Activate Specific Layout"
msgstr "Activar diseño específico"

#: prefs_hotkeys.js:66
msgid "Apply a specific saved layout using its assigned slot number."
msgstr "Aplique un diseño guardado específico utilizando su número de ranura asignado."

#: prefs_hotkeys.js:67
msgid "Configurable"
msgstr ""

#: prefs_hotkeys.js:72
msgid "Stack Navigation"
msgstr "Navegación de pila"

#: prefs_hotkeys.js:73
msgid ""
"Interact with the Stack Indicator overlay when multiple windows share a zone."
msgstr "Interactúe con la superposición del indicador de pila cuando varias ventanas comparten una zona."

#: prefs_hotkeys.js:76
msgid "Cycle Stacked Windows"
msgstr "Ciclo de ventanas apiladas"

#: prefs_hotkeys.js:77
msgid ""
"While hovering over a Stack Indicator, use the arrow keys to quickly page "
"through the stacked windows."
msgstr "Mientras pasa el cursor sobre un indicador de pila, utilice las teclas de flecha para desplazarse rápidamente por las ventanas apiladas."

#: prefs_hotkeys.js:78
msgid "Left / Right Arrows"
msgstr "Flechas izquierda/derecha"

#: prefs_hotkeys.js:83
msgid "Quick Tiler (Grid Spawning)"
msgstr "Quick Tiler (generación de cuadrícula)"

#: prefs_hotkeys.js:84
msgid ""
"Instantly resize the focused window using an interactive grid overlay. "
"Configure this hotkey in the Layouts tab."
msgstr "Cambie instantáneamente el tamaño de la ventana enfocada usando una superposición de cuadrícula interactiva. Configure esta tecla de acceso rápido en la pestaña Diseños."

#: prefs_hotkeys.js:87
msgid "Open Quick Tiler"
msgstr "Abrir mosaico rápido"

#: prefs_hotkeys.js:88
msgid ""
"Press to spawn a centered 8x8 grid on the active monitor, then click and "
"drag across cells to reshape the active window."
msgstr "Presione para generar una cuadrícula de 8x8 centrada en el monitor activo, luego haga clic y arrastre a través de las celdas para remodelar la ventana activa."

#: prefs_hotkeys.js:89
msgid "Configurable (Default: Super + G)"
msgstr "Configurable (predeterminado: Super + G)"

