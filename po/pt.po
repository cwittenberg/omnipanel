msgstr "Aplique um layout salvo específico usando o número do slot atribuído."

#: prefs_hotkeys.js:67
msgid "Configurable"
msgstr "Configurável"

#: prefs_hotkeys.js:72
msgid "Stack Navigation"
msgstr "Navegação na pilha"

#: prefs_hotkeys.js:73
msgid ""
"Interact with the Stack Indicator overlay when multiple windows share a zone."
msgstr "Interaja com a sobreposição do indicador de pilha quando várias janelas compartilham uma zona."

#: prefs_hotkeys.js:76
msgid "Cycle Stacked Windows"
msgstr "Ciclo de janelas empilhadas"

#: prefs_hotkeys.js:77
msgid ""
"While hovering over a Stack Indicator, use the arrow keys to quickly page "
