#: prefs_hotkeys.js:45
msgid "Drag & Drop Override"
msgstr "Substituição de arrastar e soltar"

#: prefs_hotkeys.js:46
msgid "Bypass OmniPanel's layout engine for manual window placement."
msgstr "Ignore o mecanismo de layout do OmniPanel para posicionamento manual de janelas."

#: prefs_hotkeys.js:49
msgid "Temporarily Disable Snapping"
msgstr "Desativar temporariamente o ajuste"

#: prefs_hotkeys.js:50
msgid ""
"Hold this modifier while dragging a window to hide Drop Zones and allow free-"
"floating placement. Releasing the window drops its zone affinity."
msgstr "Segure este modificador enquanto arrasta uma janela para ocultar as zonas de lançamento e permitir o posicionamento flutuante. Liberar a janela diminui sua afinidade de zona."

#: prefs_hotkeys.js:51
msgid "Hold Alt (or Alt Gr)"
msgstr "Segure Alt (ou Alt Gr)"

#: prefs_hotkeys.js:56
msgid "Layout Management"
msgstr "Gerenciamento de Layout"

#: prefs_hotkeys.js:57
msgid "These shortcuts can be customized in the Layouts tab."
msgstr "Esses atalhos podem ser personalizados na guia Layouts."

#: prefs_hotkeys.js:60
msgid "Cycle Layouts"
msgstr "Layouts de ciclo"

#: prefs_hotkeys.js:61
msgid "Instantly switch between your saved layouts."
msgstr "Alterne instantaneamente entre os layouts salvos."

#: prefs_hotkeys.js:62
msgid "Configurable (Default: Alt + -)"
msgstr "Configurável (padrão: Alt + -)"

#: prefs_hotkeys.js:65
msgid "Activate Specific Layout"
msgstr "Ativar layout específico"

#: prefs_hotkeys.js:66
