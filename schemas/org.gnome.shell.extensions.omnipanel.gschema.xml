<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.omnipanel" path="/org/gnome/shell/extensions/omnipanel/">
    <key name="movement-enabled" type="b">
      <default>true</default>
      <summary>Enable Multi-Monitor Top Panel</summary>
    </key>
    <key name="movement-speed" type="i">
      <default>200</default>
      <summary>Movement Polling Speed</summary>
    </key>
    <key name="animation-style" type="s">
      <default>'slide'</default>
      <summary>Animation Style</summary>
    </key>
    <key name="animation-duration" type="i">
      <default>300</default>
      <summary>Animation Duration</summary>
    </key>
    <key name="highlight-active" type="b">
      <default>false</default>
      <summary>Highlight Active Panel</summary>
    </key>
    <key name="active-panel-color" type="s">
      <default>'rgba(255, 100, 0, 0.3)'</default>
      <summary>Active Panel Color</summary>
    </key>
    <key name="translucent-inactive" type="b">
      <default>false</default>
      <summary>Translucent Inactive Bars</summary>
    </key>
    <key name="inactive-opacity" type="d">
      <default>0.5</default>
      <summary>Inactive Opacity</summary>
    </key>
    <key name="show-clock" type="b">
      <default>true</default>
      <summary>Show Static Clock</summary>
    </key>
    <key name="hide-inactive-panels" type="b">
      <default>false</default>
      <summary>Hide toolbars on inactive screens</summary>
    </key>
    <key name="show-desktop-enabled" type="b">
      <default>false</default>
      <summary>Enable Show Desktop Button</summary>
    </key>

    <key name="enable-tiling" type="b">
      <default>false</default>
      <summary>Enable Window Snapping &amp; Layouts</summary>
    </key>
    <key name="auto-restore-layouts" type="b">
      <default>true</default>
      <summary>Remember Layouts per Monitor Setup</summary>
    </key>
    <key name="fuzzy-restore-monitors" type="b">
      <default>true</default>
      <summary>Fuzzy Monitor Matching</summary>
    </key>
    <key name="enable-smart-placement" type="b">
      <default>true</default>
      <summary>Fuzzy Auto-Placement</summary>
    </key>
    <key name="enable-stack-indicators" type="b">
      <default>true</default>
      <summary>Enable Zone Stack Indicators</summary>
    </key>
    <key name="stack-indicator-position" type="s">
      <default>'bottom-right'</default>
      <summary>Stack Indicator Position</summary>
    </key>
    <key name="default-stack-mode" type="s">
      <default>'stack'</default>
      <summary>Default Stack Layout Mode</summary>
    </key>
    <key name="default-layout" type="s">
      <default>''</default>
      <summary>Default Startup Layout</summary>
    </key>
    <key name="switch-layout" type="as">
      <default><![CDATA[['<Alt>minus']]]></default>
      <summary>Cycle Layouts Shortcut</summary>
    </key>
    <key name="saved-tiling-layouts" type="s">
      <default>'{}'</default>
      <summary>Internal Tiling State</summary>
    </key>
    <key name="named-layouts" type="s">
      <default>'{}'</default>
      <summary>User Named Layouts</summary>
    </key>
    <key name="custom-sections" type="s">
      <default>'{}'</default>
      <summary>User Custom Drop Zones</summary>
    </key>

    <key name="enable-debug-logs" type="b">
      <default>false</default>
      <summary>Enable Debug Logging</summary>
    </key>

    <key name="snap-left" type="as"><default><![CDATA[['<Alt>Left']]]></default><summary>Snap Window Left</summary></key>
    <key name="snap-right" type="as"><default><![CDATA[['<Alt>Right']]]></default><summary>Snap Window Right</summary></key>
    <key name="snap-up" type="as"><default><![CDATA[['<Alt>Up']]]></default><summary>Snap Window Up</summary></key>
    <key name="snap-down" type="as"><default><![CDATA[['<Alt>Down']]]></default><summary>Snap Window Down</summary></key>

    <key name="layout-hotkey-1" type="as"><default>[]</default><summary>Layout Hotkey 1</summary></key>
    <key name="layout-hotkey-2" type="as"><default>[]</default><summary>Layout Hotkey 2</summary></key>
    <key name="layout-hotkey-3" type="as"><default>[]</default><summary>Layout Hotkey 3</summary></key>
    <key name="layout-hotkey-4" type="as"><default>[]</default><summary>Layout Hotkey 4</summary></key>
    <key name="layout-hotkey-5" type="as"><default>[]</default><summary>Layout Hotkey 5</summary></key>
    <key name="layout-hotkey-6" type="as"><default>[]</default><summary>Layout Hotkey 6</summary></key>
    <key name="layout-hotkey-7" type="as"><default>[]</default><summary>Layout Hotkey 7</summary></key>
    <key name="layout-hotkey-8" type="as"><default>[]</default><summary>Layout Hotkey 8</summary></key>
    <key name="layout-hotkey-9" type="as"><default>[]</default><summary>Layout Hotkey 9</summary></key>
  </schema>
</schemalist>