#: prefs_hotkeys.js:45
msgid "Drag & Drop Override"
msgstr "Overschrijven door slepen en neerzetten"

#: prefs_hotkeys.js:46
msgid "Bypass OmniPanel's layout engine for manual window placement."
msgstr "Omzeil de layout-engine van OmniPanel voor handmatige vensterplaatsing."

#: prefs_hotkeys.js:49
msgid "Temporarily Disable Snapping"
msgstr "Schakel snappen tijdelijk uit"

#: prefs_hotkeys.js:50
msgid ""
"Hold this modifier while dragging a window to hide Drop Zones and allow free-"
"floating placement. Releasing the window drops its zone affinity."
msgstr "Houd deze modifier ingedrukt terwijl je een venster sleept om Drop Zones te verbergen en vrij zwevende plaatsing mogelijk te maken. Als u het venster vrijgeeft, wordt de zoneaffiniteit ervan verlaagd."

#: prefs_hotkeys.js:51
