msgstr "Houd Alt (of Alt Gr) ingedrukt"

#: prefs_hotkeys.js:56
msgid "Layout Management"
msgstr "Lay-outbeheer"

#: prefs_hotkeys.js:57
msgid "These shortcuts can be customized in the Layouts tab."
msgstr "Deze snelkoppelingen kunnen worden aangepast op het tabblad Lay-outs."

#: prefs_hotkeys.js:60
msgid "Cycle Layouts"
