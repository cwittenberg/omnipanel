msgstr "Terwijl u over een stapelindicator beweegt, gebruikt u de pijltoetsen om snel door de gestapelde vensters te bladeren."

#: prefs_hotkeys.js:78
msgid "Left / Right Arrows"
msgstr "Links/rechts pijlen"

#: prefs_hotkeys.js:83
msgid "Quick Tiler (Grid Spawning)"
msgstr "Snelle tegelzetter (rasterspawning)"

#: prefs_hotkeys.js:84
