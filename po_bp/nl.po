#: prefs_hotkeys.js:61
msgid "Instantly switch between your saved layouts."
msgstr "Schakel direct tussen uw opgeslagen lay-outs."

#: prefs_hotkeys.js:62
msgid "Configurable (Default: Alt + -)"
msgstr "Configureerbaar (standaard: Alt + -)"

#: prefs_hotkeys.js:65
