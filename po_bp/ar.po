#: prefs_hotkeys.js:30
msgid "Hotkeys"
msgstr "مفاتيح الاختصار"

#: prefs_hotkeys.js:35
msgid "Directional Snapping"
msgstr "الالتقاط الاتجاهي"

#: prefs_hotkeys.js:36
msgid "Quickly snap the currently focused window into adjacent Drop Zones."
msgstr "قم بجذب النافذة التي تم التركيز عليها حاليًا بسرعة إلى مناطق الإسقاط المجاورة."

#: prefs_hotkeys.js:38
msgid "Snap Left"
msgstr "التقط اليسار"

#: prefs_hotkeys.js:38
msgid "Move window to the nearest zone on the left."
msgstr "انقل النافذة إلى أقرب منطقة على اليسار."

#: prefs_hotkeys.js:38
msgid "Alt + Left"
msgstr "البديل + اليسار"

#: prefs_hotkeys.js:39
msgid "Snap Right"
msgstr "التقط لليمين"

#: prefs_hotkeys.js:39
msgid "Move window to the nearest zone on the right."
msgstr "انقل النافذة إلى أقرب منطقة على اليمين."

#: prefs_hotkeys.js:39
msgid "Alt + Right"
msgstr "البديل + اليمين"

#: prefs_hotkeys.js:40
msgid "Snap Up"
msgstr "التقط"

#: prefs_hotkeys.js:40
msgid "Move window to the nearest zone above."
msgstr "انقل النافذة إلى أقرب منطقة أعلاه."

#: prefs_hotkeys.js:40
msgid "Alt + Up"
msgstr "البديل + أعلى"

#: prefs_hotkeys.js:41
msgid "Snap Down"
msgstr "التقط للأسفل"

#: prefs_hotkeys.js:41
msgid "Move window to the nearest zone below."
msgstr "انقل النافذة إلى أقرب منطقة أدناه."

#: prefs_hotkeys.js:41
msgid "Alt + Down"
msgstr "البديل + أسفل"

#: prefs_hotkeys.js:45
msgid "Drag & Drop Override"
msgstr "تجاوز السحب والإفلات"

#: prefs_hotkeys.js:46
msgid "Bypass OmniPanel's layout engine for manual window placement."
msgstr "تجاوز محرك تخطيط OmniPanel لوضع النوافذ يدويًا."

#: prefs_hotkeys.js:49
msgid "Temporarily Disable Snapping"
msgstr "تعطيل الالتقاط مؤقتًا"

#: prefs_hotkeys.js:50
msgid ""
"Hold this modifier while dragging a window to hide Drop Zones and allow free-"
"floating placement. Releasing the window drops its zone affinity."
msgstr "استمر في الضغط على هذا المُعدِّل أثناء سحب النافذة لإخفاء مناطق الإسقاط والسماح بالموضع الحر. يؤدي تحرير النافذة إلى إسقاط تقارب المنطقة الخاصة بها."

#: prefs_hotkeys.js:51
msgid "Hold Alt (or Alt Gr)"
msgstr "اضغط باستمرار على Alt (أو Alt Gr)"

#: prefs_hotkeys.js:56
msgid "Layout Management"
msgstr "إدارة التخطيط"

#: prefs_hotkeys.js:57
msgid "These shortcuts can be customized in the Layouts tab."
msgstr "يمكن تخصيص هذه الاختصارات في علامة التبويب \"التخطيطات\"."

#: prefs_hotkeys.js:60
msgid "Cycle Layouts"
msgstr "تخطيطات الدورة"

#: prefs_hotkeys.js:61
msgid "Instantly switch between your saved layouts."
msgstr "قم بالتبديل على الفور بين تخطيطاتك المحفوظة."

#: prefs_hotkeys.js:62
msgid "Configurable (Default: Alt + -)"
msgstr "قابل للتكوين (الافتراضي: Alt + -)"

#: prefs_hotkeys.js:65
msgid "Activate Specific Layout"
msgstr "تنشيط التخطيط المحدد"

#: prefs_hotkeys.js:66
msgid "Apply a specific saved layout using its assigned slot number."
msgstr "قم بتطبيق تخطيط محفوظ محدد باستخدام رقم الفتحة المخصص له."

#: prefs_hotkeys.js:67
msgid "Configurable"
msgstr "شكلي"

#: prefs_hotkeys.js:72
msgid "Stack Navigation"
msgstr "التنقل المكدس"

#: prefs_hotkeys.js:73
msgid ""
"Interact with the Stack Indicator overlay when multiple windows share a zone."
msgstr "تفاعل مع تراكب Stack Indicator عندما تشترك عدة نوافذ في منطقة ما."

#: prefs_hotkeys.js:76
msgid "Cycle Stacked Windows"
msgstr "دورة النوافذ المكدسة"

#: prefs_hotkeys.js:77
msgid ""
"While hovering over a Stack Indicator, use the arrow keys to quickly page "
"through the stacked windows."
msgstr "أثناء التمرير فوق مؤشر Stack Indicator، استخدم مفاتيح الأسهم للتصفح بسرعة عبر النوافذ المكدسة."

#: prefs_hotkeys.js:78
msgid "Left / Right Arrows"
msgstr "أسهم لليسار / لليمين"

#: prefs_hotkeys.js:83
msgid "Quick Tiler (Grid Spawning)"
msgstr "بلاط سريع (وضع الشبكة)"

#: prefs_hotkeys.js:84
msgid ""
"Instantly resize the focused window using an interactive grid overlay. "
"Configure this hotkey in the Layouts tab."
msgstr "قم بتغيير حجم النافذة المركزة على الفور باستخدام تراكب الشبكة التفاعلية. قم بتكوين مفتاح التشغيل السريع هذا في علامة التبويب \"التخطيطات\"."

#: prefs_hotkeys.js:87
msgid "Open Quick Tiler"
msgstr "افتح Quick Tiler"

#: prefs_hotkeys.js:88
msgid ""
"Press to spawn a centered 8x8 grid on the active monitor, then click and "
"drag across cells to reshape the active window."
msgstr "اضغط لإنشاء شبكة مركزية مقاس 8x8 على الشاشة النشطة، ثم انقر واسحب عبر الخلايا لإعادة تشكيل النافذة النشطة."

#: prefs_hotkeys.js:89
msgid "Configurable (Default: Super + G)"
msgstr "قابل للتكوين (الافتراضي: Super + G)"

#: prefs_tiling.js:18
msgid "Layouts"
msgstr "التخطيطات"

#: prefs_tiling.js:25
msgid "Enable Window Management"
msgstr "تمكين إدارة النوافذ"

#: prefs_tiling.js:26
msgid "Master switch for all OmniPanel tiling, snapping, and layout features"
msgstr "مفتاح رئيسي لجميع ميزات التبليط والالتقاط والتخطيط في OmniPanel"

#: prefs_tiling.js:36
msgid "Zone-Based Tiling"
msgstr "التبليط على أساس المنطقة"

#: prefs_tiling.js:40
msgid "Draw and configure drop zones visually across your screens"
msgstr "ارسم مناطق الإسقاط وقم بتكوينها بشكل مرئي عبر شاشاتك"

#: prefs_tiling.js:51
msgid "Auto-Restore Layouts"
msgstr "الاستعادة التلقائية للتخطيطات"

#: prefs_tiling.js:52
msgid "Remember window positions based on monitor setups"
msgstr "تذكر مواضع النوافذ بناءً على إعدادات الشاشة"

#: prefs_tiling.js:63
msgid "Fuzzy Monitor Matching"
msgstr "مطابقة الشاشة الغامضة"

#: prefs_tiling.js:64
msgid "Restore layouts if monitor count matches despite resolution changes"
msgstr "قم باستعادة التخطيطات إذا كان عدد أجهزة العرض متطابقًا على الرغم من تغييرات الدقة"

#: prefs_tiling.js:74
msgid "Automation & Defaults"
msgstr "الأتمتة والافتراضيات"

#: prefs_tiling.js:77
msgid "Fuzzy Auto-Placement"
msgstr "وضع تلقائي غامض"

#: prefs_tiling.js:78
msgid ""
"Automatically assign new unrecognized windows to zones matching their name "
"or category"
msgstr "قم بتعيين النوافذ الجديدة غير المعروفة تلقائيًا للمناطق المطابقة لاسمها أو فئتها"

#: prefs_tiling.js:89
msgid "Remember App Affinity"
msgstr "تذكر تقارب التطبيق"

#: prefs_tiling.js:90
msgid "Restore apps to their last known zone upon relaunch"
msgstr "استعادة التطبيقات إلى آخر منطقة معروفة لها عند إعادة التشغيل"

#: prefs_tiling.js:101
msgid "Configure Auto-Placement Rules"
msgstr "تكوين قواعد التنسيب التلقائي"

#: prefs_tiling.js:102
msgid "Easily manage app keywords and categories for layout routing"
msgstr "يمكنك إدارة الكلمات الرئيسية والفئات الخاصة بالتطبيق بسهولة لتوجيه التخطيط"

#: prefs_tiling.js:105
msgid "Configure"
msgstr "تكوين"

#: prefs_tiling.js:116
msgid "Default Startup Layout"
msgstr "تخطيط بدء التشغيل الافتراضي"

#: prefs_tiling.js:117
msgid "Layout applied automatically when extension loads"
msgstr "يتم تطبيق التخطيط تلقائيًا عند تحميل الامتداد"

#: prefs_tiling.js:122
msgid "Window Exclusions"
msgstr "استثناءات النافذة"

#: prefs_tiling.js:123
msgid ""
"Provide a comma-separated list of application names (e.g. gimp, steam) to "
"completely exclude them from being snapped or managed by OmniPanel."
msgstr "قم بتوفير قائمة مفصولة بفواصل بأسماء التطبيقات (مثل gimp وsteam) لاستبعادها تمامًا من التقاطها أو إدارتها بواسطة OmniPanel."

#: prefs_tiling.js:139
msgid "Stack Indicators"
msgstr "مؤشرات المكدس"

#: prefs_tiling.js:142
msgid "Zone Stack Indicators"
msgstr "مؤشرات مكدس المنطقة"

#: prefs_tiling.js:143
msgid ""
"Show a fast-switching overlay when multiple windows share the same drop zone"
msgstr "إظهار تراكب سريع التبديل عندما تشترك عدة نوافذ في نفس منطقة الإفلات"

#: prefs_tiling.js:154
msgid "Stack Indicator Position"
msgstr "موقف مؤشر المكدس"

#: prefs_tiling.js:155
msgid "Corner of the window to draw the overlay"
msgstr "زاوية النافذة لرسم التراكب"

#: prefs_tiling.js:156
msgid "Bottom Left"
msgstr "أسفل اليسار"

#: prefs_tiling.js:156
msgid "Bottom Right"
msgstr "أسفل اليمين"

#: prefs_tiling.js:167
msgid "Default Stack Layout"
msgstr "تخطيط المكدس الافتراضي"

#: prefs_tiling.js:168
msgid "Initial view behavior when multiple windows enter a zone"
msgstr "سلوك العرض الأولي عند دخول عدة نوافذ إلى منطقة ما"

#: prefs_tiling.js:169
msgid "Stack (On Top)"
msgstr "كومة (في الأعلى)"

#: prefs_tiling.js:169
msgid "Columns (Side by Side)"
msgstr "الأعمدة (جنبًا إلى جنب)"

#: prefs_tiling.js:169
msgid "Rows (Vertical List)"
msgstr "الصفوف (قائمة عمودية)"

#: prefs_tiling.js:169
msgid "Grid (Tiled)"
msgstr "الشبكة (مبلطة)"

#: prefs_tiling.js:185
msgid "Keyboard Shortcuts"
msgstr "اختصارات لوحة المفاتيح"

